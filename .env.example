# ============================================================
# AI Resume Analyzer & Job Matcher — Environment Configuration
# ============================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit real secrets to source control.

# ── NVIDIA NIM ──────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Frontend ─────────────────────────────────────────────────
# This value is safe to expose in the browser (points to your local/deployed backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Backend Server ───────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── File Upload Limits ───────────────────────────────────────
MAX_FILE_SIZE_MB=5
